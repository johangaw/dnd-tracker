{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-tracker/monster-schema.json",
  "title": "D&D 5e Monster",
  "description": "Schema for importing custom monsters (5e.tools compatible format)",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Monster name",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "description": "Source book abbreviation (e.g., MM, PHB, Custom)",
      "default": "Custom"
    },
    "size": {
      "type": "array",
      "description": "Size category",
      "items": {
        "type": "string",
        "enum": ["T", "S", "M", "L", "H", "G"]
      },
      "default": ["M"]
    },
    "type": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      ],
      "description": "Creature type (e.g., humanoid, beast, dragon)"
    },
    "alignment": {
      "type": "array",
      "description": "Alignment abbreviations",
      "items": {
        "type": "string",
        "enum": ["L", "N", "C", "G", "E", "U", "A"]
      },
      "default": ["N"]
    },
    "ac": {
      "type": "array",
      "description": "Armor class entries",
      "items": {
        "oneOf": [
          { "type": "integer" },
          {
            "type": "object",
            "properties": {
              "ac": { "type": "integer", "description": "AC value" },
              "from": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Sources of AC (e.g., natural armor, shield)"
              },
              "condition": { "type": "string" }
            },
            "required": ["ac"]
          }
        ]
      },
      "default": [{ "ac": 10 }]
    },
    "hp": {
      "type": "object",
      "description": "Hit points",
      "properties": {
        "average": { "type": "integer", "description": "Average HP" },
        "formula": { "type": "string", "description": "HP dice formula (e.g., 2d8+2)" }
      },
      "required": ["average"]
    },
    "speed": {
      "type": "object",
      "description": "Movement speeds in feet",
      "properties": {
        "walk": { "type": "integer" },
        "fly": { "type": "integer" },
        "swim": { "type": "integer" },
        "climb": { "type": "integer" },
        "burrow": { "type": "integer" },
        "hover": { "type": "boolean" }
      },
      "default": { "walk": 30 }
    },
    "str": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "dex": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "con": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "int": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "wis": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "cha": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "save": {
      "type": "object",
      "description": "Saving throw bonuses",
      "properties": {
        "str": { "type": "string" },
        "dex": { "type": "string" },
        "con": { "type": "string" },
        "int": { "type": "string" },
        "wis": { "type": "string" },
        "cha": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "description": "Skill bonuses (e.g., { \"perception\": \"+5\" })",
      "additionalProperties": { "type": "string" }
    },
    "immune": {
      "type": "array",
      "description": "Damage immunities",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "immune": { "type": "array", "items": { "type": "string" } },
              "note": { "type": "string" },
              "cond": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "resist": {
      "type": "array",
      "description": "Damage resistances",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "resist": { "type": "array", "items": { "type": "string" } },
              "note": { "type": "string" },
              "cond": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "vulnerable": {
      "type": "array",
      "description": "Damage vulnerabilities",
      "items": { "type": "string" }
    },
    "conditionImmune": {
      "type": "array",
      "description": "Condition immunities",
      "items": { "type": "string" }
    },
    "senses": {
      "type": "array",
      "description": "Special senses (e.g., darkvision 60 ft.)",
      "items": { "type": "string" }
    },
    "passive": {
      "type": "integer",
      "description": "Passive Perception score"
    },
    "languages": {
      "type": "array",
      "description": "Languages known",
      "items": { "type": "string" }
    },
    "cr": {
      "oneOf": [
        { "type": "string", "pattern": "^(0|1/8|1/4|1/2|[1-9]|[12][0-9]|30)$" },
        {
          "type": "object",
          "properties": {
            "cr": { "type": "string" },
            "lair": { "type": "string" },
            "coven": { "type": "string" }
          }
        }
      ],
      "description": "Challenge rating"
    },
    "trait": {
      "type": "array",
      "description": "Special traits/abilities",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Trait name" },
          "entries": {
            "type": "array",
            "description": "Trait description",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          }
        },
        "required": ["name", "entries"]
      }
    },
    "action": {
      "type": "array",
      "description": "Actions",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Action name" },
          "entries": {
            "type": "array",
            "description": "Action description",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          }
        },
        "required": ["name", "entries"]
      }
    },
    "reaction": {
      "type": "array",
      "description": "Reactions",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "entries": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object" }] } }
        },
        "required": ["name", "entries"]
      }
    },
    "legendary": {
      "type": "array",
      "description": "Legendary actions",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "entries": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object" }] } }
        },
        "required": ["name", "entries"]
      }
    },
    "spellcasting": {
      "type": "array",
      "description": "Spellcasting abilities",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "headerEntries": { "type": "array", "items": { "type": "string" } },
          "spells": { "type": "object" },
          "will": { "type": "array", "items": { "type": "string" } },
          "daily": { "type": "object" }
        }
      }
    }
  },
  "examples": [
    {
      "name": "Custom Goblin",
      "size": ["S"],
      "type": "humanoid",
      "alignment": ["N", "E"],
      "ac": [{ "ac": 15, "from": ["leather armor", "shield"] }],
      "hp": { "average": 7, "formula": "2d6" },
      "speed": { "walk": 30 },
      "str": 8,
      "dex": 14,
      "con": 10,
      "int": 10,
      "wis": 8,
      "cha": 8,
      "skill": { "stealth": "+6" },
      "senses": ["darkvision 60 ft."],
      "passive": 9,
      "languages": ["Common", "Goblin"],
      "cr": "1/4",
      "trait": [
        {
          "name": "Nimble Escape",
          "entries": ["The goblin can take the Disengage or Hide action as a bonus action on each of its turns."]
        }
      ],
      "action": [
        {
          "name": "Scimitar",
          "entries": ["Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 5 (1d6 + 2) slashing damage."]
        },
        {
          "name": "Shortbow",
          "entries": ["Ranged Weapon Attack: +4 to hit, range 80/320 ft., one target. Hit: 5 (1d6 + 2) piercing damage."]
        }
      ]
    }
  ]
}
